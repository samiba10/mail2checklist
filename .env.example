# Public URL of the web app (used in WhatsApp links)
BASE_URL=https://your-domain.example
DB_PATH=checklists.db

# Gmail: which mails to turn into checklists (Gmail search syntax)
GMAIL_QUERY=from:sender@example.com subject:"רשימת לקוחות" -label:processed
GMAIL_PROCESSED_LABEL=processed
GMAIL_CREDENTIALS=credentials.json
GMAIL_TOKEN=token.json
POLL_SECONDS=180
# Server only: content of token.json from `python -m app.gmail_auth` (no browser on servers)
GMAIL_TOKEN_JSON=

# Optional: enables the overview page at /?key=<ADMIN_KEY>. Leave empty to disable it.
ADMIN_KEY=

# WhatsApp Cloud API (Meta). Leave WA_TOKEN empty to only print previews.
WA_TOKEN=
WA_PHONE_ID=
# Recipient(s), comma-separated. Local numbers (05X-XXXXXXX) are converted using WA_COUNTRY_CODE.
WA_TO=05X-XXXXXXX
WA_COUNTRY_CODE=972
WA_TEMPLATE=new_checklist
WA_LANG=he
